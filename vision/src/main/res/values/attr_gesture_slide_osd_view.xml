<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="GestureSlideOsdView">
        <attr name="android:color" />
        <attr name="lineWidth" format="dimension" />
        <attr name="stepCount" format="integer" />
        <!-- 文字大小占 View 高度的比例 -->
        <attr name="textSizeRatio" format="float" />
        <!-- 普通刻度线顶部占 View 高度的比例 -->
        <attr name="lineTopRatio" format="float" />
        <!-- 普通刻度线底部占 View 高度的比例 -->
        <attr name="lineBottomRatio" format="float" />
        <!-- 中心高亮刻度线顶部占 View 高度的比例 -->
        <attr name="centerLineTopRatio" format="float" />
        <!-- 中心高亮刻度线底部占 View 高度的比例 -->
        <attr name="centerLineBottomRatio" format="float" />
        <!-- 时间文字基线占 View 高度的比例 -->
        <attr name="textRatio" format="float" />
    </declare-styleable>
</resources>
