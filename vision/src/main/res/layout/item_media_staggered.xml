<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    tools:layout_width="150dp">

    <com.lollipop.common.ui.view.RatioFrameLayout
        android:id="@+id/ratioLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.lollipop.common.ui.view.RoundOutlineLayout
            android:id="@+id/outlineLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:radius="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mediaPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/button_mask"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/durationView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_item_media_tag"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    tools:text="12:34" />

                <TextView
                    android:id="@+id/labelView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/bg_item_media_tag"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/button_text"
                    android:textSize="11sp"
                    tools:text="TestNameTestNameTestName" />

            </LinearLayout>

        </com.lollipop.common.ui.view.RoundOutlineLayout>

    </com.lollipop.common.ui.view.RatioFrameLayout>

</FrameLayout>
