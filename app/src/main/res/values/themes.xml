<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MediaFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorPrimary">#FF00BDAD</item>
        <item name="colorSecondary">#FFCC6B6B</item>
        <item name="colorTertiary">#FF72935A</item>
    </style>

    <style name="Theme.MediaFlow" parent="Base.Theme.MediaFlow">
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.BodyLarge</item>
        <item name="popupMenuBackground">@drawable/menu_popup_background</item>
        <!-- 弹层窗口必须为 translucent，Android 12+ 的系统背景模糊才会生效 -->
        <item name="android:dialogTheme">@style/Theme.MediaFlow.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.MediaFlow.Dialog</item>
    </style>

    <!--
        Flow 页（视频 / 图片 / 快捷播放）主题：媒体画面为绝对主角，系统栏图标恒为浅色，
        不跟随系统明暗主题。

        为什么必须同时写在主题里：Flow 页声明了 configChanges，旋转不会重建 Activity，
        但系统在窗口属性重新下发时会按**主题**恢复 windowLightStatusBar，
        覆盖掉运行时 WindowInsetsController 的做法（表现为旋转后状态栏变回系统样式）。
        主题与运行时设置同向声明后，无论系统何时重新下发，结果都是浅色图标。
    -->
    <style name="Theme.MediaFlow.Flow" parent="Theme.MediaFlow">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge"/>

    <!--
        对话框主题：透明窗口 + 无标题。
        Android 12+ 的 Window.setBackgroundBlurRadius 要求窗口为 translucent，
        否则系统会直接忽略模糊请求（表现为「内容透明了但没有模糊」）。
    -->
    <style name="Theme.MediaFlow.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
